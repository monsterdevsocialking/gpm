APP_NAME="GPM Conecta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Luanda
APP_LOCALE=pt_AO
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gpm_conecta
DB_USERNAME=root
DB_PASSWORD=

# Optional: used only when running php artisan db:seed to create the first admin.
# Never commit real credentials to GitHub.
GPM_ADMIN_NAME=
GPM_ADMIN_EMAIL=
GPM_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@gpmconecta.local"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY=
PAYMENT_WEBHOOK_TOLERANCE=300
SUPPLIER_INTEGRATION=
SHIPPING_INTEGRATION=
NOTIFICATION_PROVIDER=
